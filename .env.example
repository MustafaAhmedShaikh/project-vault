# ProjectVault settings. Copy this file to ".env" and edit the copy.
# Never commit ".env". Every line below is optional; the defaults are safe.
# Values already set in your real environment win over this file.

# Folder to back up. Empty = the folder that contains the ProjectVault scripts.
WORKSPACE_DIR=""

# Where backups go: local, gdrive, s3, or both (local plus every cloud you configured).
STORAGE_TARGET="local"

# Daily backup time, HH:MM in 24-hour LOCAL time. A missed backup runs when the daemon next starts.
BACKUP_SCHEDULE_HOUR="02:00"

# How many verified backups to keep (whole number, 1 or more). 1 = only the newest.
BACKUP_KEEP="1"

# Extra files to skip: comma-separated glob patterns, e.g. "*.mp4,data/raw/*".
BACKUP_EXCLUDE=""

# Keep "false". If "true", .env files, keys and credentials are put in the (unencrypted) zip.
BACKUP_INCLUDE_SECRETS="false"

# Local port the daemon uses to make sure only one copy runs (127.0.0.1 only).
VAULT_DAEMON_PORT="58745"

# Telegram alerts (optional). Token comes from @BotFather; chat ID from your bot's getUpdates.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# ntfy alerts (optional). Pick a long, hard-to-guess topic name.
NTFY_TOPIC=""
NTFY_SERVER="https://ntfy.sh"

# Google Drive (only if STORAGE_TARGET uses gdrive). Use EITHER the API settings OR the local folder.
GDRIVE_FOLDER_ID=""
GDRIVE_SERVICE_ACCOUNT_PATH=""
# Path to a folder synced by the Google Drive desktop app (no API needed).
GDRIVE_LOCAL_PATH=""

# S3-compatible storage (beta; only if STORAGE_TARGET uses s3). Works with AWS S3, R2, B2, MinIO.
S3_BUCKET_NAME=""
# Leave empty for AWS S3. For R2/B2/MinIO use that service's endpoint URL.
S3_ENDPOINT_URL=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_REGION="auto"
# Optional folder-like prefix inside the bucket, e.g. "my-project/".
S3_KEY_PREFIX=""
